{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Start Backend (Node)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/backend/server.js",
      "cwd": "${workspaceFolder}/backend",
      "runtimeExecutable": "node",
      "env": {
        "PORT": "5000"
      },
      "console": "integratedTerminal",
      "restart": true
    },
    {
      "name": "Start Frontend (React)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/frontend/node_modules/react-scripts/bin/react-scripts.js",
      "args": [
        "start"
      ],
      "cwd": "${workspaceFolder}/frontend",
      "runtimeExecutable": "node",
      "console": "integratedTerminal",
      "restart": true
    }
  ],
  "compounds": [
    {
      "name": "Start Full App (Frontend + Backend)",
      "configurations": ["Start Backend (Node)", "Start Frontend (React)"]
    }
  ]
}